# Copy this file to .env and fill in your values.
# Never commit .env to version control.

LANGUAGE_FORGE_PROVIDER=openai
LANGUAGE_FORGE_API_KEY=your_key_here
# LANGUAGE_FORGE_MODEL=gpt-4o
# LANGUAGE_FORGE_BASE_URL=
# LANGUAGE_FORGE_MAX_TOKENS=2048

# For Anthropic:
# LANGUAGE_FORGE_PROVIDER=anthropic
# LANGUAGE_FORGE_API_KEY=your_anthropic_key_here

# For local (Ollama etc.):
# LANGUAGE_FORGE_PROVIDER=local
# LANGUAGE_FORGE_BASE_URL=http://localhost:11434/v1
# LANGUAGE_FORGE_MODEL=llama3
# LANGUAGE_FORGE_API_KEY=ollama
